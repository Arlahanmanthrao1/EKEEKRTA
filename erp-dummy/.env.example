DATABASE_URL=sqlite:///./erp.db
# Generate a long random token. Enter this same value in EKEEKRTA's
# Admin -> ERP Integration page. Never commit the real token.
ERP_API_TOKEN=replace-with-a-random-token-at-least-24-characters
# Must match "Institution ID in ERP" on the EKEEKRTA ERP page.
ERP_INSTITUTION_ID=HITAM
ERP_NAME=HITAM ERP Sandbox
RECENT_RECORD_LIMIT=100

# Optional official Meta WhatsApp Cloud API absence alerts. Keep disabled until
# the institution has collected parent/guardian opt-in and Meta has approved
# the utility template named below.
WHATSAPP_NOTIFICATIONS_ENABLED=false
WHATSAPP_GRAPH_API_VERSION=vXX.X
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_ABSENCE_TEMPLATE_NAME=class_absence_alert
WHATSAPP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_REQUEST_TIMEOUT_SECONDS=10
WHATSAPP_MAX_ATTEMPTS=3

# Recommended absence-delivery mode for n8n. When enabled, finalized absences
# enter a protected outbox instead of being sent directly by this ERP service.
# Use a different random secret from ERP_API_TOKEN.
N8N_ABSENCE_NOTIFICATIONS_ENABLED=false
N8N_API_TOKEN=replace-with-a-separate-random-token-at-least-24-characters
N8N_MAX_ATTEMPTS=3
