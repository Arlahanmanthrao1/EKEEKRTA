DATABASE_URL=sqlite:///./lms.db
SECRET_KEY=replace-this-with-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
MINIMUM_ATTENDANCE_MINUTES=30
RECORDING_STORAGE_DIR=private-recordings
RECORDING_MAX_UPLOAD_MB=250
JIBRI_RECORDINGS_DIR=
JIBRI_RECORDING_MAX_MB=10000
RECORDING_RETENTION_DAYS=0
# Institution-built executables only. Leave empty until reviewed model packages exist.
NATIVE_SPEECH_MODEL_EXECUTABLE=
NATIVE_SPEECH_MODEL_ID=
NATIVE_SLIDE_OCR_EXECUTABLE=
NATIVE_SLIDE_OCR_MODEL_ID=
NATIVE_MODEL_TIMEOUT_MINUTES=120
# Legacy setting only; new account domains come from the institution profile.
ALLOWED_EMAIL_DOMAIN=hitam.org
# OAuth client type: Web application. Client ID is public; no client secret needed.
# Leave empty until your real Google OAuth client and allowed origins are ready.
GOOGLE_CLIENT_ID=
# Password recovery email. Use a dedicated institution sender account/app password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_SECURITY=starttls
PASSWORD_RESET_BASE_URL=http://127.0.0.1:5173
PASSWORD_RESET_EXPIRE_MINUTES=30
CODE_RUNNER_URL=https://ce.judge0.com
CODE_RUNNER_API_KEY=
CODE_RUNNER_TIMEOUT_MS=3000

# JaaS Dev: obtain these from the JaaS console; never put the private key in Vite.
VIDEO_PROVIDER=jaas
JAAS_APP_ID=
JAAS_API_KEY_ID=
JAAS_PRIVATE_KEY_PATH=secrets/jaas-private.pem
# On Vercel, set JAAS_PRIVATE_KEY to the PEM contents in its protected environment
# settings instead of using a local path. Never expose it through VITE_ variables.
JAAS_PRIVATE_KEY=
JAAS_TOKEN_EXPIRE_MINUTES=60
# Used only with VIDEO_PROVIDER=jitsi (public testing or future college host).
JITSI_DOMAIN=meet.jit.si
JITSI_JWT_APP_ID=
JITSI_JWT_APP_SECRET=
JITSI_JWT_EXPIRE_MINUTES=60
# Self-hosted Jitsi/Jibri only. Keep false for meet.jit.si and JaaS development.
JITSI_AUTO_RECORDING_ENABLED=false
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Custom institution portals: empty until domain ownership and tenant ownership
# are reviewed by the operator. No database or DNS changes happen automatically.
INSTITUTION_LOGIN_HOSTS={}
# Example after verification: {"ekeekrta.hitam.org":"hitam.org"}
# Configured hosts are also allowed as exact HTTPS CORS origins.
# ERP endpoints and credentials are configured per institution by an
# administrator in the EKEEKRTA portal. Tokens are encrypted using SECRET_KEY.
